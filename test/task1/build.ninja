# PWMake 0.1.0
# ===== Compiler =====
compiler_path = /opt/homebrew/opt/llvm@19/bin/clang++
compiler_flags = -std=c++23 -stdlib=libc++ -Isrc/shared 
rule compile
  command = $compiler_path $compiler_flags -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
rule compile_lib
  command = $compiler_path $compiler_flags -fPIC -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
link_flags = -stdlib=libc++
rule binary
  command = $compiler_path $in -o $out $link_flags
ar = ar
rule static_library
  command = $ar rc $out $in
rule shared_library
  command = $compiler_path -shared $in -o $out $link_flags
# ===== Make Object =====
obj = ./build/obj
bin = ./build/task1
build $obj/task1/src/com1/main.o: compile src/com1/main.cpp
build $bin: binary $obj/task1/src/com1/main.o 
default $bin
# ===== Make Object =====
obj = ./build/obj
bin = ./build/libtest_dylib.dylib
build $obj/test_dylib/src/shared/code.o: compile src/shared/code.cpp
build $bin: shared_library $obj/test_dylib/src/shared/code.o 
default $bin
# ===== Make Object =====
obj = ./build/obj
bin = ./build/task2
build $obj/task2/src/com2/main.o: compile src/com2/main.cpp
build $bin: binary $obj/task2/src/com2/main.o build/libtest_dylib.dylib 
default $bin
