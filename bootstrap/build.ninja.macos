# PWMake 0.1.0 For macos bootstrap
# ===== Compiler =====
# if your clang++ or gcc compiler is other, modify it.
compiler_path = /opt/homebrew/opt/llvm/bin/clang++
compiler_flags = -std=c++23 -stdlib=libc++ -g -O0
rule compile
  command = $compiler_path $compiler_flags -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
rule compile_lib
  command = $compiler_path $compiler_flags -fPIC -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
link_flags = -stdlib=libc++
rule binary
  command = $compiler_path $in -o $out $link_flags
ar = ar
rule static_library
  command = $ar rc $out $in
rule shared_library
  command = $compiler_path -shared $in -o $out $link_flags
# ===== Make Object =====
obj = ./build/obj
bin = ./build/pwmake
build $obj/pwmake/src/cmd/cmd.o: compile src/cmd/cmd.cpp
build $obj/pwmake/src/clangd/clangd.o: compile src/clangd/clangd.cpp
build $obj/pwmake/src/config/config.o: compile src/config/config.cpp
build $obj/pwmake/src/lexer/lexer.o: compile src/lexer/lexer.cpp
build $obj/pwmake/src/lexer/transform.o: compile src/lexer/transform.cpp
build $obj/pwmake/src/cli/input.o: compile src/cli/input.cpp
build $obj/pwmake/src/cli/run.o: compile src/cli/run.cpp
build $obj/pwmake/src/ninja/ninja.o: compile src/ninja/ninja.cpp
build $obj/pwmake/src/main.o: compile src/main.cpp
build $bin: binary $obj/pwmake/src/cmd/cmd.o $obj/pwmake/src/clangd/clangd.o $obj/pwmake/src/config/config.o $obj/pwmake/src/lexer/lexer.o $obj/pwmake/src/lexer/transform.o $obj/pwmake/src/cli/input.o $obj/pwmake/src/cli/run.o $obj/pwmake/src/ninja/ninja.o $obj/pwmake/src/main.o 
default $bin

