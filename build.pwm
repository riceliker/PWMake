# PWMake 1.0
$bool($value, true)
:if(value)
  print("hello world")
:fi

@compiler(compiler_path)
  language_version("c++23")
  standard_library("libc++")
  compiler_debug()
  link_param("-Wl", "-rpath", "/opt/homebrew/lib")
;

@files("source")
  recursion_folder("src", ".cpp")
;

@project("pwmake", "binary")
  source_files("source")
;