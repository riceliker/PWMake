# PWMake 1.0
@compiler("/opt/homebrew/opt/llvm@19/bin/clang++")
  language_version("c++23")
  standard_library("libc++")
  compiler_debug()
  library_header("/opt/homebrew/include/SDL3")
;

@files("Source")
  recursion_folder("src", ".cpp")
;

@project("PWMake", "binary")
  source_files("Source")
  add_library("/opt/homebrew/lib/libSDL3.dylib")
;
