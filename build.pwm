# PWMake 0.1.0

@compiler("/opt/homebrew/opt/llvm@19/bin/clang++")
compiler_standard_language!("c++23")
compiler_standard_library!("libc++")
compiler_warning()
compiler_extra_warning()
compiler_debug()
;

@files("source_file")
add_file?("./src/main.cpp")
foreach_file?("./src", ".cpp")
;

@project("Hello", "binary")
source_files!("source_file")
;