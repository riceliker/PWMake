# 1. 全局编译器、路径常量
llvm_root = /opt/homebrew/opt/llvm@19
clangxx = $llvm_root/bin/clang++
mod_cache = ./build/mods
obj_dir = ./build/obj
target_bin = ./build/app

# 编译通用参数（C++23 Module + libc++ 修复 libc++.modules.json 警告）
cxxflags = -std=c++23 -stdlib=libc++ -Wall -Wextra -g -O0
ldflags = -stdlib=libc++

# 2. 规则1：编译 .cppm 模块接口文件
rule mod_compile
  command = $clangxx $cxxflags -c $in -o $out
  description = Build module interface $in

# 3. 规则2：编译普通 .cpp 源码
rule src_compile
  command = $clangxx $cxxflags -c $in -o $out
  description = Build source $in

# 4. 规则3：链接所有obj生成可执行程序
rule link_bin
  command = $clangxx $ldflags $in -o $out
  description = Link executable $out

# 5. 规则4：清理构建产物
rule clean
  command = rm -rf $mod_cache $obj_dir $target_bin
  description = Clean all build artifacts

# --------------------------
# 批量定义文件编译任务
# --------------------------
# 模块接口文件
build $obj_dir/main.o: src_compile src/main.cpp | src/core/mod.hpp
build $obj_dir/file.o: src_compile src/core/file.cpp | src/core/mod.hpp
build $obj_dir/ninja.o: src_compile src/core/ninja.cpp | src/core/mod.hpp
build $obj_dir/lexer.o: src_compile src/core/lexer.cpp | src/core/mod.hpp


# 普通源码文件
# build $obj_dir/main.o: src_compile src/main.cpp

# 收集所有obj用于链接


# 链接最终程序
build $target_bin: link_bin $obj_dir/main.o $obj_dir/file.o $obj_dir/ninja.o $obj_dir/lexer.o

# 伪目标：默认执行编译链接
default $target_bin

# 清理伪目标
build clean: clean
